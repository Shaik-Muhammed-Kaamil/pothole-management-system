{
  "compilerOptions": {
    "target": "ES2021",
    "module": "commonjs",
    //"moduleResolution": "node",
    "outDir": "dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "allowJs": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*", 
    "prisma.config.ts", 
    "prisma/seed.ts",
    "prisma.d.ts",
    ".env"
  ],
  "exclude": ["node_modules"]
}